{
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "node scripts/serve-export.mjs",
    "typecheck": "tsc --noEmit",
    "check:interactions": "node scripts/check-arrival.mjs && node scripts/check-disclosures.mjs && node scripts/check-journey-motion.mjs && node scripts/check-crystal.mjs && node scripts/check-instruments.mjs && node scripts/check-skill-cabinet.mjs && node scripts/check-gallery.mjs && node scripts/check-project-arrival.mjs && node scripts/check-discovery-cues.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check": "pnpm typecheck && pnpm check:interactions",
    "deps:install": "pnpm install --ignore-scripts",
    "deps:audit": "pnpm audit --prod",
    "deps:approve-builds": "pnpm approve-builds"
  },
  "dependencies": {
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
