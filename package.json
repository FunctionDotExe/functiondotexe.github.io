{
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "node scripts/serve-export.mjs",
    "typecheck": "tsc --noEmit",
    "check:interactions": "node scripts/check-arrival.mjs && node scripts/check-disclosures.mjs && node scripts/check-journey-motion.mjs && node scripts/check-crystal.mjs && node scripts/check-instruments.mjs && node scripts/check-skill-cabinet.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check": "pnpm typecheck && pnpm check:interactions",
    "deps:install": "pnpm install --ignore-scripts",
    "deps:audit": "pnpm audit --prod",
    "deps:approve-builds": "pnpm approve-builds"
  },
  "dependencies": {
    "lenis": "^1.3.4",
    "lucide-react": "^0.516.0",
    "next": "^16.2.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
